{
  "schema_version": 1,
  "project": "PocketMonsters-Sapphire-Decompilation",
  "platform": "Game Boy Advance",
  "cpu": "ARM7TDMI",
  "bootstrap": "tools/setup_gba_environment.sh",
  "local_install_root": ".local",
  "components": [
    {
      "id": "devkitarm",
      "kind": "cross_toolchain",
      "required": true,
      "provider": "devkitPro",
      "package": "gba-dev",
      "version_policy": "current devkitPro package set",
      "purpose": ["assemble", "link", "objdump", "modern_gcc", "gba_utilities"]
    },
    {
      "id": "agbcc",
      "kind": "matching_compiler",
      "required": true,
      "provider": "pret/agbcc",
      "repository": "https://github.com/pret/agbcc",
      "commit": "da598c1d918402c42c0c0d7128ba14567f3175e9",
      "install_path": ".local/agbcc-sdk/tools/agbcc",
      "purpose": ["generation_iii_matching_compilation"]
    },
    {
      "id": "mgba",
      "kind": "emulator",
      "required": true,
      "provider": "mgba-emu/mgba",
      "repository": "https://github.com/mgba-emu/mgba",
      "version": "0.10.5",
      "install_path": ".local/emulators/mgba",
      "purpose": ["runtime_verification", "debugging", "rtc_testing", "save_testing", "link_testing"]
    },
    {
      "id": "host-build-tools",
      "kind": "host_dependencies",
      "required": true,
      "packages": ["git", "make", "gcc", "g++", "python3", "pkg-config", "libpng-dev"],
      "purpose": ["tool_builds", "analysis_scripts", "asset_tools"]
    },
    {
      "id": "ghidra",
      "kind": "static_analysis",
      "required": false,
      "provider": "NationalSecurityAgency/ghidra",
      "version": "12.1.3",
      "runtime_requirement": "64-bit JDK 25",
      "purpose": ["interactive_static_analysis", "cross_references", "function_recovery"]
    }
  ],
  "verification": {
    "checker": "tools/check_gba_environment.py",
    "status": "bootstrap_and_manifest_defined",
    "third_party_binaries_committed": false
  },
  "notes": [
    "Third-party tool binaries are installed locally under .local and are not committed.",
    "Retail ROM images remain outside the repository.",
    "Tool versions may be advanced deliberately only after compatibility and matching effects are reviewed."
  ]
}
